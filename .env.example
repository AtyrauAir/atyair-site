# =============================================================================
# atyair — шаблон переменных окружения
# Скопируй этот файл как .env и заполни своими значениями:
#   cp .env.example .env
#   nano .env
# =============================================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=atyair
POSTGRES_DB=atyair
POSTGRES_PASSWORD=generate_with_openssl_rand_base64_32
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- FastAPI Backend ----------
# Сгенерируй: openssl rand -hex 32
BACKEND_SECRET_KEY=generate_with_openssl_rand_hex_32
BACKEND_LOG_LEVEL=INFO

# Домены, которым разрешён доступ к API
ALLOWED_ORIGINS=https://atyair.org,https://www.atyair.org

# ---------- Open-Meteo API ----------
# API бесплатный и не требует ключа
OPEN_METEO_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# Частота опроса источников (минуты)
FETCH_INTERVAL_MINUTES=60

# ---------- AQICN (опционально, v1.5) ----------
# Получить: https://aqicn.org/data-platform/token/
AQICN_TOKEN=

# ---------- Точки мониторинга ----------
# Формат: ИМЯ|ШИРОТА|ДОЛГОТА, разделитель запятая
MONITORING_POINTS=Центр города|47.1067|51.9233,Район НПЗ|47.0489|51.8422,Балыкши|47.0294|51.9250,Нурсая|47.1284|51.8987,Аэропорт|47.1217|51.8141,Курмангазы|47.0850|51.9600,Авангард|47.0967|51.9050,Привокзальный|47.1150|51.9450

# ---------- Домен ----------
DOMAIN=atyair.org
EMAIL_FOR_LETSENCRYPT=your_email@example.com

# ---------- Часовой пояс ----------
TZ=Asia/Atyrau
